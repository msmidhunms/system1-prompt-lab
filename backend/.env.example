# Copy to backend/.env and adjust. Every value here is the default.
DEBUG=false
TOP_N_FEEDBACK=5

# Laya runs on the CPU unless a GPU is named here ("cuda", "mps") or "auto".
LAYA_DEVICE=cpu

# Share of each example's golden data that the optimizer never shows the LLM.
EVAL_HOLDOUT_RATIO=0.1
# Search intent only: the language of the queries that are evaluated and optimized on.
EVAL_LANGUAGE=en

# API keys for the LLM that proposes prompts. They can also be entered in the app's settings.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
